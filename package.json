{
  "name": "floci-ui",
  "version": "1.1.0",
  "private": true,
  "description": "Modern Web UI and Management Dashboard for Floci Cloud Emulator",
  "scripts": {
    "dev": "next dev",
    "build": "next build && mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ 2>/dev/null || true",
    "start": "PORT=3000 node .next/standalone/server.js",
    "lint": "next lint"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.654.0",
    "@aws-sdk/client-ec2": "^3.654.0",
    "@aws-sdk/client-iam": "^3.654.0",
    "@aws-sdk/client-kms": "^3.654.0",
    "@aws-sdk/client-s3": "^3.654.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.441.0",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "5.9.3"
  }
}
